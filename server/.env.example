# Natxios server configuration. Copy to server/.env and fill in.
# Never commit the real .env. Every value the server uses is read from here.
# Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

# ----- App -----
NODE_ENV=development
PORT=4000
# morgan log format; empty = "dev" locally, "combined" in production
LOG_FORMAT=
# Built client folder, relative to the server folder (or an absolute path)
CLIENT_DIST_PATH=../client/dist

# ----- Redis (optional; empty = in-memory, counts reset on restart) -----
# Shares rate limits, quiz counters, bans, single-use tokens and the daily facts cache
# across server instances. Local: redis://127.0.0.1:6379  Upstash: rediss://default:<password>@<host>:6379
REDIS_URL=
# Leave empty: defaults to true in production (refuse to start without Redis), false locally
REDIS_REQUIRED=
REDIS_KEY_PREFIX=natxios:
# Leave empty: defaults to true in production (refuse to start if Redis may evict our keys).
# Redis itself should use: maxmemory-policy noeviction
REDIS_REQUIRE_NOEVICTION=
REDIS_CONNECT_TIMEOUT_MS=5000

# ----- Database (optional for now; empty = newsletter returns 503) -----
# Local:  mongodb://127.0.0.1:27017/natxios
# Atlas:  mongodb+srv://<username>:<password>@<cluster>.mongodb.net/natxios?retryWrites=true&w=majority
MONGODB_URI=
DB_SERVER_SELECTION_TIMEOUT_MS=10000

# ----- CORS / CSRF -----
# Comma separated, no trailing slash. Production: https://natxios.org,https://www.natxios.org
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000
CORS_MAX_AGE_SECONDS=600

# ----- Secrets (each at least 32 characters, all different) -----
FORM_TOKEN_SECRET=change-me-form-token-secret-at-least-32-characters
IP_HASH_SALT=change-me-ip-hash-salt-at-least-32-characters-long
QUIZ_SECRET=change-me-quiz-secret-at-least-32-characters-long
# Decrypts the question bank (questions.enc). Required in production. Keep it safe:
# without it the encrypted bank cannot be read.
BANK_ENCRYPTION_KEY=change-me-bank-encryption-key-at-least-32-characters
# Changes the order fact of the day walks through the bank (not secret)
FACT_ROTATION_SEED=natxios-fact-of-the-day

# ----- Proxy and HTTP limits -----
# REQUIRED in production. Number of reverse proxies in front of the app:
# 0 = none, 1 = Render/Railway/Nginx, 2 = Cloudflare in front of one of those.
TRUST_PROXY=0
JSON_BODY_LIMIT=10kb
MAX_HEADER_SIZE_BYTES=8192
HEADERS_TIMEOUT_MS=15000
REQUEST_TIMEOUT_MS=30000
KEEP_ALIVE_TIMEOUT_MS=5000
MAX_REQUESTS_PER_SOCKET=200
HSTS_MAX_AGE_SECONDS=63072000
SHUTDOWN_TIMEOUT_MS=10000

# ----- Rate limits (requests per IP per window) -----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_SITE=1000
RATE_LIMIT_API=300
API_SLOWDOWN_AFTER=120
API_SLOWDOWN_STEP_MS=200
API_SLOWDOWN_MAX_MS=3000
RATE_LIMIT_FACTS=60
RATE_LIMIT_FORM_TOKEN=30
RATE_LIMIT_QUIZ_STATUS=120
RATE_LIMIT_QUIZ_ROUND=30
RATE_LIMIT_QUIZ_ANSWER=120
RATE_LIMIT_NEWSLETTER_PER_HOUR=5

# ----- Abuse guard (bans IPs probing for .env, .git, wp-admin, .php ...) -----
ABUSE_MAX_PROBES=5
ABUSE_WINDOW_MINUTES=10
ABUSE_BAN_MINUTES=60

# ----- Form tokens (bot protection on the newsletter form) -----
FORM_TOKEN_MIN_AGE_SECONDS=2
FORM_TOKEN_MAX_AGE_MINUTES=120

# ----- Admin (/admin). Leave the email empty to disable the admin area completely -----
# ADMIN_PASSWORD is for local development only.
ADMIN_EMAIL=admin@natxios.org
ADMIN_PASSWORD=change-me-to-a-long-random-password
# Production: use a hash instead (npm run admin:hash) and remove ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
# Two-factor login code secret (npm run admin:2fa). Required in production.
ADMIN_TOTP_SECRET=
# Optional: comma separated IPs allowed to use /admin (empty = any)
ADMIN_IP_ALLOWLIST=
ADMIN_IDLE_MINUTES=30
ADMIN_FAILED_LOGIN_DELAY_MS=600
ADMIN_SESSION_TTL_MINUTES=120
ADMIN_COOKIE_NAME=nx_admin
RATE_LIMIT_ADMIN_LOGIN=5
ADMIN_LOCKOUT_AFTER_FAILS=10
ADMIN_LOCKOUT_MINUTES=30

# ----- Logging (errors only are written to LOG_DIR/error.log, rotated by size) -----
LOG_DIR=logs
LOG_LEVEL=info
LOG_MAX_SIZE_MB=5
LOG_MAX_FILES=5

# ----- Visitor metrics (anonymous daily counts, no cookies) -----
METRICS_RETENTION_DAYS=90

# ----- Email (SMTP). Empty SMTP_HOST = no emails sent (contact messages are still saved to MongoDB) -----
# Works with any provider: Brevo, Mailgun, Postmark, Zoho, Google Workspace, ...
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# Keep true in production (encrypts mail on port 587)
SMTP_REQUIRE_TLS=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Natxios website <no-reply@natxios.org>

# ----- Contact form -----
CONTACT_TO=info@natxios.org
RATE_LIMIT_CONTACT_PER_HOUR=3
CONTACT_MAX_PER_EMAIL_PER_DAY=5
CONTACT_MAX_LINKS=2
# Saved messages are deleted automatically after this many days
CONTACT_RETENTION_DAYS=365
# Global cap on contact emails per hour; extra messages are saved but not emailed
CONTACT_MAX_EMAILS_PER_HOUR=20

# ----- Quiz -----
QUIZ_QUESTIONS_PER_ROUND=10
QUIZ_ROUNDS_PER_DAY=2
QUIZ_ROUNDS_PER_NETWORK_PER_DAY=6
