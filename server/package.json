{
  "name": "@natxios/server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "NODE_ENV=production node --env-file-if-exists=.env src/index.js",
    "bank:encrypt": "node --env-file-if-exists=.env scripts/bank.js encrypt",
    "bank:decrypt": "node --env-file-if-exists=.env scripts/bank.js decrypt",
    "admin:hash": "node --env-file-if-exists=.env scripts/admin.js hash",
    "admin:2fa": "node --env-file-if-exists=.env scripts/admin.js 2fa"
  },
  "dependencies": {
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "express-slow-down": "^3.1.1",
    "helmet": "^8.3.0",
    "mongoose": "^9.12.0",
    "morgan": "^1.12.1",
    "nodemailer": "^10.3.1",
    "rate-limit-redis": "^6.0.2",
    "redis": "^6.3.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  }
}
