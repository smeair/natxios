# Natxios client configuration. Copy to client/.env.
# Only variables starting with VITE_ reach the browser, so never put secrets here.

# Dev server (npm run dev)
VITE_DEV_PORT=5173
# Where the dev server forwards /api requests (the Express server)
VITE_API_PROXY_TARGET=http://localhost:4000

# Social media (a platform without a URL is hidden)
VITE_INSTAGRAM_URL=https://www.instagram.com/natxios
VITE_INSTAGRAM_HANDLE=@natxios
VITE_FACEBOOK_URL=https://www.facebook.com/natxios
VITE_FACEBOOK_HANDLE=/natxios
VITE_YOUTUBE_URL=https://www.youtube.com/@official.natxios
VITE_YOUTUBE_HANDLE=@official.natxios

# Public address of the site, used in shared quiz scorecards (no trailing slash)
VITE_SITE_URL=https://natxios.org

# Legal pages (/privacy and /terms)
VITE_LEGAL_NAME=Natxios
VITE_CONTACT_EMAIL=legal@natxios.org
VITE_LEGAL_JURISDICTION=England and Wales
VITE_LEGAL_UPDATED=7 November 2026
